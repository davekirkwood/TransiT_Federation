<?xml version="1.0" encoding="UTF-8"?>

<objectModel
    xmlns="http://standards.ieee.org/1527"
    xsi:schemaLocation="http://standards.ieee.org/1527 HLA.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelIdentification>
        <name>Simple Message FOM</name>
        <version>1.0</version>
        <modificationDate>2026-09-14</modificationDate>
        <purpose>
            Simple FOM demonstrating message passing and time synchronization.
        </purpose>
        <applicationDomain>Simple Simulation</applicationDomain>
    </modelIdentification>

    <objects>
        <objectClass>
            <name>HLAobjectRoot</name>
            <sharing>Neither</sharing>
        </objectClass>
    </objects>

    <interactions>

        <interactionClass>
            <name>HLAinteractionRoot</name>
            <sharing>Neither</sharing>

            <interactionClass>
                <name>Message</name>
                <sharing>PublishSubscribe</sharing>
                <transportation>HLAreliable</transportation>
                <order>TimeStamp</order>

                <parameter>
                    <name>MessageText</name>
                    <dataType>HLAunicodeString</dataType>
                </parameter>

            </interactionClass>
        </interactionClass>

    </interactions>

    <dataTypes>
        <basicDataRepresentations>
            <basicData>
                <name>HLAunicodeString</name>
                <size>0</size>
                <interpretation>
                    Unicode string.
                </interpretation>
            </basicData>
        </basicDataRepresentations>
    </dataTypes>

</objectModel>
